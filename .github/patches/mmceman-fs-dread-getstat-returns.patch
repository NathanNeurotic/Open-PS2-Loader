diff --git a/mmceman/src/mmce_fs.c b/mmceman/src/mmce_fs.c
--- a/mmceman/src/mmce_fs.c
+++ b/mmceman/src/mmce_fs.c
@@ -834,7 +834,9 @@ int mmce_fs_dread(iomanX_iop_file_t *file, iox_dirent_t *dirent)
 
     mmce_sio2_unlock();
 
-    return rdbuf[0x1]; //itr fd from mmce
+    // 1, not the card's iterator fd: iomanX reads 0 as end of directory, and the card hands out its
+    // lowest free descriptor, which is 0 if the folder was opened while fd 0 was busy (mmceman #11).
+    return 1;
 }
 
 int mmce_fs_getstat(iomanX_iop_file_t *file, const char *name, iox_stat_t *stat)
@@ -937,8 +939,10 @@ int mmce_fs_getstat(iomanX_iop_file_t *file, const char *name, iox_stat_t *stat)
     stat->hisize |= rdbuf[0x28];
 
     if (rdbuf[0x29] != 0) {
+        // -ENOENT, not -1: the card answers 1 only when it could not open the path; timeouts and
+        // garbled replies above stay -1 (ps2-mmce/mmceman #11).
         DPRINTF("Got bad return: %i\n", rdbuf[0x29]);
-        return -1;
+        return -ENOENT;
     } else {
         DPRINTF("Got good return\n");
     }
